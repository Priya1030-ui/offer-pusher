# 本地或云端部署时填写为环境变量。
#
# 飞书自建应用 / 智能体
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 多维表格
FEISHU_APP_TOKEN=bitable_app_token
FEISHU_TABLE_ID=table_id
FEISHU_VIEW_ID=view_id
FEISHU_WIKI_URL=https://你的飞书/wiki链接

# 收件人
FEISHU_PREVIEW_OPEN_ID=ou_xxx
FEISHU_GROUP_CHAT_ID=oc_xxx

# 展示文案
OFFER_TITLE_PREFIX=校招Offer开奖参考
OFFER_SOURCE_TEXT=整理自Offershow等校招薪资分享中高可信度及热门案例

# 公网部署后启用飞书账号登录
FEISHU_LOGIN_REQUIRED=true
PUBLIC_BASE_URL=https://你的域名

# 可选：只允许指定飞书 open_id 访问，多个用英文逗号分隔；留空则登录即可访问
FEISHU_ALLOWED_OPEN_IDS=ou_xxx

# 公网模式默认禁止从页面修改应用配置；确有需要再打开
ALLOW_CONFIG_EDIT=false
